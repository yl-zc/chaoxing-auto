console/stop-request.json
engine/queue_state.jsonl

# ===== 浏览器 profile / 登录态（含 Cookie，绝不入库） =====
profile/
browser-profile/
runtime/browser-profile/

# ===== Python 缓存 / 虚拟环境 =====
__pycache__/
*.py[cod]
*.pyd
.venv/
venv/
env/
*.egg-info/

