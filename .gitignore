# ===== 运行时不入库（体积大 / 与环境相关） =====
runtime/
models/
*.gguf

# ===== 运行产物 / 日志 / 证据 =====
logs/
runs/
plans/
*.log
engine/runs/
engine/logs/
engine/.locks/
